#!/usr/bin/env bash
# Repo checks: everything verifiable from the source tree alone, without
# touching the running machine (that is tests/verify-xps). Fast enough to gate
# a deploy — `verify` runs it ahead of the machine checks and `update --full`
# runs it before ansible-playbook. Every stage runs even if an earlier one
# fails; the exit status is nonzero when any of them did.
set -uo pipefail

cd -- "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

failed_stages=()

if [[ -t 1 ]]; then
  C_GREEN=$'\033[32m' C_RED=$'\033[31m' C_OFF=$'\033[0m'
else
  C_GREEN='' C_RED='' C_OFF=''
fi

pass() { printf '%sPASS%s  %-11s %s\n' "$C_GREEN" "$C_OFF" "$1" "${2:-}"; }
fail() {
  printf '%sFAIL%s  %-11s %s\n' "$C_RED" "$C_OFF" "$1" "${2:-}"
  failed_stages+=("$1")
}

# Milliseconds since the epoch. EPOCHREALTIME renders its decimal separator
# per locale, so strip everything that is not a digit rather than splitting.
now_ms() { local t=${EPOCHREALTIME:-}; t=${t//[^0-9]/}; printf '%s' "$(( ${t:-0} / 1000 ))"; }
took() { printf '(%d.%02ds)' "$(( $1 / 1000 ))" "$(( $1 % 1000 / 10 ))"; }

# Indented failure excerpt, bounded so one broken file cannot bury the summary.
excerpt() {
  local text=$1 max=${2:-60} n
  n=$(printf '%s\n' "$text" | wc -l)
  printf '%s\n' "$text" | head -n "$max" | sed 's/^/      /'
  ((n > max)) && printf '      … %d more lines\n' "$((n - max))"
  return 0
}

# ── Noctalia configuration and Hyprland integration ─────────────────────────
stage_noctalia() {
  local out rc=0 t0 elapsed

  t0=$(now_ms)
  out=$(python3 - <<'PY' 2>&1
from pathlib import Path
import tomllib

config_path = Path("roles/desktop/files/noctalia/config.toml")
config = tomllib.loads(config_path.read_text())

assert config["shell"]["polkit_agent"] is True
assert config["shell"]["setup_wizard_enabled"] is False
assert config["notification"]["enable_daemon"] is True
assert config["lockscreen"]["enabled"] is True
assert config["idle"]["behavior"]["lock"]["timeout"] == 300
assert config["idle"]["behavior"]["screen-off"]["timeout"] == 600
assert config["bar"]["main"]["position"] == "top"
assert "launcher" in config["bar"]["main"]["start"]
assert "control-center" in config["bar"]["main"]["end"]

tasks = Path("roles/desktop/tasks/main.yml").read_text()
autostart = Path("roles/desktop/files/autostart.lua").read_text()
bindings = Path("roles/desktop/files/bindings.lua").read_text()
look = Path("roles/desktop/files/looknfeel.lua").read_text()
finalize = Path("roles/finalize/tasks/main.yml").read_text()

assert "- noctalia" in tasks
assert "src: noctalia/" in tasks
assert ".local/state/noctalia/.setup-complete" in tasks
assert "hl.exec_cmd([[noctalia]])" in autostart
assert "noctalia msg " in bindings
assert "panel-toggle launcher" in bindings
assert "settings-toggle" in bindings
assert "session lock" in bindings
assert "noctalia-(bar-.+|notification|dock|panel|attached-panel|osd|window-switcher)" in look
assert "hyprland-noctalia" in finalize

assert not Path("roles/desktop/files/quickshell").exists()
assert not Path("tests/quickshell").exists()
assert not Path("roles/desktop/templates/quickshell.service.j2").exists()
print("TOML and Hyprland integration contract valid")
PY
) || rc=$?

  if ((rc == 0)) && command -v noctalia >/dev/null 2>&1; then
    semantic=$(noctalia config validate roles/desktop/files/noctalia/config.toml 2>&1) || rc=$?
    grep -q 'WARN' <<<"$semantic" && rc=1
    out+=$'\n'"$semantic"
  fi
  elapsed=$(( $(now_ms) - t0 ))

  if ((rc == 0)); then
    pass 'Noctalia' "config and integration $(took "$elapsed")"
  else
    fail 'Noctalia' 'configuration or integration check failed'
    excerpt "$out"
  fi
}

# ── XPS 2026 hardware integration sanity checks ────────────────────────────
stage_xps_hardware() {
  local out rc=0 t0 elapsed biquads
  local shell_files=(
    roles/xps-2026/files/xps-speaker-tuning
    roles/xps-2026/files/xps-fingerprint-detect
    roles/xps-2026/files/xps-fingerprint-check
    roles/xps-2026/files/camera/xps-ipu7-camera-check
    roles/xps-2026/files/camera/xps-ipu7-camera-init
    roles/xps-2026/files/camera/xps-ipu7-camera-sleep
  )

  t0=$(now_ms)
  for source_file in "${shell_files[@]}"; do
    out=$(bash -n "$source_file" 2>&1) || {
      rc=1
      break
    }
  done

  if ((rc == 0)); then
    out=$(python3 - <<'PY' 2>&1
from pathlib import Path
import os
import subprocess
import tempfile

python_files = (
    Path("roles/xps-2026/files/xps-haptic-touchpad"),
    Path("roles/xps-2026/files/camera/xps-ipu7-abi-check"),
    Path("roles/xps-2026/files/camera/xps-ipu7-userspace-check"),
)
for path in python_files:
    compile(path.read_text(), str(path), "exec")

detector = Path("roles/xps-2026/files/xps-fingerprint-detect").resolve()

def detect(vendor, product_id, product="", driver=""):
    with tempfile.TemporaryDirectory() as temporary:
        devices = Path(temporary) / "devices"
        device = devices / "1-1"
        device.mkdir(parents=True)
        (device / "idVendor").write_text(vendor + "\n")
        (device / "idProduct").write_text(product_id + "\n")
        if product:
            (device / "product").write_text(product + "\n")
        if driver:
            target = Path(temporary) / "drivers" / driver
            target.mkdir(parents=True)
            interface = device / "1-1:1.0"
            interface.mkdir()
            (interface / "driver").symlink_to(target)
        environment = os.environ.copy()
        environment["XPS_USB_DEVICES_PATH"] = str(devices)
        return subprocess.run(
            ["bash", str(detector)], env=environment, capture_output=True
        ).returncode == 0

assert not detect("06cb", "0701", "SVP7500"), "camera bridge detected as reader"
assert not detect("06cb", "9999", "Generic USB", "usbio-bridge"), "driven Synaptics device detected"
assert detect("27c6", "1234"), "unclaimed known-vendor reader not detected"
assert detect("1234", "5678", "Goodix Fingerprint USB Device", "usbhid"), "named reader not detected"
print("Python syntax and fingerprint detection fixtures valid")
PY
) || rc=1
  fi

  if ((rc == 0)); then
    out=$(python3 roles/xps-2026/files/camera/xps-ipu7-abi-check --self-test 2>&1) || rc=1
  fi

  biquads=$(grep -Ec 'name = s([0-9]+)_[lr]' roles/xps-2026/files/xps-speaker-filter-chain.conf)
  if ((rc == 0)) && [[ $biquads != 26 ]]; then
    out="speaker profile has $biquads biquads; expected 26"
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'limiter_stereo' roles/xps-2026/files/xps-speaker-filter-chain.conf; then
    out='speaker profile is missing the stereo limiter'
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'IPU7_PSYS_ONLY=1' roles/xps-2026/files/camera/patches/0005-ipu7-psys-stock-core-layout.patch; then
    out='camera patch does not enforce stock-core PSYS-only DKMS builds'
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'xps-ipu7-abi-check.*kernelver' roles/xps-2026/files/camera/patches/0005-ipu7-psys-stock-core-layout.patch; then
    out='camera DKMS build does not enforce the stock-core BTF ABI guard'
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'intel-ipu7-psys[.]ko' roles/xps-2026/files/camera/xps-ipu7-abi-check; then
    out='camera ABI guard does not yield to a future Fedora-native PSYS module'
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'xps-ipu7-userspace-check --root' roles/xps-2026/templates/xps-ipu7-build.j2; then
    out='camera package build does not prove staged userspace dependency closure'
    rc=1
  fi
  if ((rc == 0)) && ! grep -q 'ansible.builtin.meta: end_role' roles/xps-2026/tasks/camera.yml; then
    out='optional camera dependency failures are not isolated from the play'
    rc=1
  fi
  if ((rc == 0)); then
    if out=$(rg -n 'linux-ptl|fred=on|disable_11be|BUILT_MODULE_NAME.*intel-ipu7(-isys)?"' \
      roles/xps-2026/tasks roles/xps-2026/defaults roles/xps-2026/templates 2>&1); then
      rc=1
    fi
  fi

  elapsed=$(( $(now_ms) - t0 ))
  if ((rc == 0)); then
    pass 'XPS hardware' "scripts, 13-biquad graph, and stock-core camera guard $(took "$elapsed")"
  else
    fail 'XPS hardware' 'static hardware integration check failed'
    excerpt "${out:-unknown failure}"
  fi
}

stage_noctalia
stage_xps_hardware

# Keep the verdict on the last line: `update` tails this output into its own
# failure report, so the actionable summary has to survive the truncation.
if ((${#failed_stages[@]} > 0)); then
  printf '\n%d of 2 repo check stages failed: %s\n' \
    "${#failed_stages[@]}" "$(IFS=, ; printf '%s' "${failed_stages[*]}")"
  exit 1
fi
exit 0
