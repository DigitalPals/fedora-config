#!/usr/bin/env bash
set -uo pipefail
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

require_hyprland=false
[[ ${1:-} == --require-hyprland ]] && require_hyprland=true
failures=0
warnings=0

pass() { printf '\033[32mPASS\033[0m  %s\n' "$*"; }
fail() { printf '\033[31mFAIL\033[0m  %s\n' "$*"; failures=$((failures + 1)); }
warn() { printf '\033[33mWARN\033[0m  %s\n' "$*"; warnings=$((warnings + 1)); }
skip() { printf '\033[36mSKIP\033[0m  %s\n' "$*"; }
check() {
  local label=$1; shift
  if "$@" >/dev/null 2>&1; then pass "$label"; else fail "$label"; fi
}
check_diagnostic() {
  local label=$1 output
  shift
  if output=$("$@" 2>&1); then
    pass "$label"
  else
    fail "$label"
    sed 's/^/      /' <<<"$output"
  fi
}
command_exists() { command -v "$1" >/dev/null 2>&1; }
unit_enabled() { systemctl is-enabled --quiet "$1"; }
unit_active() { systemctl is-active --quiet "$1"; }
user_unit_active() { systemctl --user is-active --quiet "$1"; }

printf '%s\n' 'Fedora XPS automated verification'
check 'Fedora 44' bash -c '. /etc/os-release; [[ $ID == fedora && $VERSION_ID == 44 ]]'
check 'hostname is xps' test "$(hostnamectl --static 2>/dev/null)" = xps
check 'timezone is Europe/Amsterdam' test "$(timedatectl show -p Timezone --value 2>/dev/null)" = Europe/Amsterdam
check 'Dell system vendor' grep -qi dell /sys/class/dmi/id/sys_vendor
check 'XPS/DA14260 product identity' grep -Eqi 'XPS|DA14260' /sys/class/dmi/id/product_name
check 'Intel Panther Lake/Core Ultra CPU' grep -Eqi 'Intel.*(Ultra|X7)|Panther Lake' /proc/cpuinfo
check 'SELinux is enforcing' test "$(getenforce 2>/dev/null)" = Enforcing
check 'Fish is john login shell' bash -c '[[ $(getent passwd john | cut -d: -f7) == /usr/bin/fish ]]'
check 'Fish prompt resolves the Fedora OS icon' fish -lic 'test "$POSH_OS_ICON" = ""'
check 'john is in required groups' bash -c 'g=$(id -nG john); for x in wheel video input docker; do grep -qw "$x" <<<"$g" || exit 1; done'
check 'user lingering is enabled' test -e /var/lib/systemd/linger/john

for unit in NetworkManager firewalld bluetooth avahi-daemon cups docker thermald; do
  check "$unit is enabled" unit_enabled "$unit.service"
done
check 'NetworkManager-wait-online is disabled' bash -c '! systemctl is-enabled --quiet NetworkManager-wait-online.service'
check 'SSH server is disabled' bash -c '! systemctl is-enabled --quiet sshd.service'
check 'SSH server is inactive' bash -c '! systemctl is-active --quiet sshd.service'
check 'weekly TRIM is enabled' unit_enabled fstrim.timer
check 'weekly Btrfs scrub is enabled' unit_enabled xps-btrfs-scrub.timer
check 'zram is active' bash -c 'swapon --show=NAME | grep -q zram'

declare -A expected_sysctl=(
  [kernel.kptr_restrict]=2 [kernel.dmesg_restrict]=1
  [kernel.perf_event_paranoid]=3 [kernel.yama.ptrace_scope]=1
  [vm.mmap_min_addr]=65536 [net.ipv4.icmp_echo_ignore_broadcasts]=1
  [net.ipv4.conf.all.accept_redirects]=0 [net.ipv4.conf.default.accept_redirects]=0
  [net.ipv6.conf.all.accept_redirects]=0 [net.ipv6.conf.default.accept_redirects]=0
)
for key in "${!expected_sysctl[@]}"; do
  value=$(sysctl -n "$key" 2>/dev/null || true)
  [[ $value == "${expected_sysctl[$key]}" ]] && pass "sysctl $key" || fail "sysctl $key=${value:-missing}, expected ${expected_sysctl[$key]}"
done
bpf=$(sysctl -n kernel.unprivileged_bpf_disabled 2>/dev/null || true)
[[ $bpf =~ ^[12]$ ]] && pass 'Fedora unprivileged BPF restriction retained' || fail "unprivileged BPF restriction is ${bpf:-missing}"
rp=$(sysctl -n net.ipv4.conf.default.rp_filter 2>/dev/null || true)
[[ $rp == 2 ]] && pass 'Fedora reverse-path filtering policy retained' || warn "default rp_filter is $rp; no override is installed by this playbook"
swappiness=$(sysctl -n vm.swappiness 2>/dev/null || true)
[[ $swappiness =~ ^[0-9]+$ && $swappiness -ge 60 ]] \
  && pass 'Fedora zram-oriented swappiness retained' || warn "swappiness is ${swappiness:-missing}"

if command_exists firewall-cmd && unit_active firewalld.service; then
  zone=$(firewall-cmd --get-default-zone 2>/dev/null || true)
  [[ $zone == xps ]] && pass 'xps is the default firewall zone' || fail "default firewall zone is ${zone:-missing}"
  ports=$(firewall-cmd --permanent --zone=xps --list-ports 2>/dev/null | tr ' ' '\n' | sort | tr '\n' ' ')
  expected=$(printf '%s\n' 10400-10401/udp 27015/tcp 27015/udp 27031-27036/udp 27036-27037/tcp 53317/tcp 53317/udp 5353/udp | sort | tr '\n' ' ')
  [[ $ports == "$expected" ]] && pass 'firewall exposes only declared ports' || fail "firewall ports differ: $ports"
  services=$(firewall-cmd --permanent --zone=xps --list-services 2>/dev/null || true)
  [[ -z $services ]] && pass 'firewall has no broad service exceptions' || fail "unexpected firewall services: $services"
  interfaces=$(firewall-cmd --permanent --zone=xps --list-interfaces 2>/dev/null || true)
  grep -qw tailscale0 <<<"$interfaces" && pass 'tailscale0 is trusted in xps zone' || fail 'tailscale0 is absent from xps zone'
  while IFS=: read -r device type state; do
    case "$type:$state" in
      ethernet:connected|wifi:connected)
        assigned=$(firewall-cmd --get-zone-of-interface="$device" 2>/dev/null || true)
        [[ $assigned == xps ]] && pass "$device is bound to xps zone" || fail "$device is bound to ${assigned:-no zone}"
        ;;
    esac
  done < <(LC_ALL=C nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null)
  while IFS=: read -r uuid type; do
    case "$type" in
      802-3-ethernet|802-11-wireless)
        assigned=$(nmcli -g connection.zone connection show "$uuid" 2>/dev/null || true)
        [[ $assigned == xps ]] && pass "$uuid profile is bound to xps zone" \
          || fail "$uuid profile is bound to ${assigned:-no zone}"
        ;;
    esac
  done < <(nmcli -t -f UUID,TYPE connection show 2>/dev/null)
else
  fail 'firewalld is active and queryable'
fi

cmdline=$(</proc/cmdline)
if grep -Eq 'iwlwifi[.]disable_11be|(^| )fred=on|xe[.](enable|force_probe)|enable_panel_replay|enable_psr' <<<"$cmdline"; then
  fail "obsolete XPS kernel workaround is present: $cmdline"
else
  pass 'no obsolete XPS kernel workarounds'
fi
check 'Intel graphics uses the xe driver' bash -c "lspci -k | grep -A4 -Ei 'VGA|Display' | grep -q 'Kernel driver in use: xe'"
check 'Intel Wi-Fi uses iwlwifi' bash -c "lspci -k | grep -A4 -Ei 'Network|Wireless' | grep -q 'Kernel driver in use: iwlwifi'"
if command_exists mokutil; then
  mokutil --sb-state >/dev/null 2>&1 && pass 'Secure Boot state is readable' || warn 'Secure Boot state could not be read'
fi
for forbidden in xps-bios-fan-control mic-led-sync tlp; do
  systemctl list-unit-files "$forbidden.service" --no-legend 2>/dev/null | grep -q . \
    && fail "excluded unit exists: $forbidden" || pass "excluded unit absent: $forbidden"
done

product_sku=$(tr -d '[:space:]' </sys/class/dmi/id/product_sku 2>/dev/null || true)
product_name=$(tr -d '\n' </sys/class/dmi/id/product_name 2>/dev/null || true)
xps_2026=false
if [[ $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) == 'Dell Inc.' ]] &&
   [[ $product_sku == 0DB9 || $product_sku == 0DBA ]] &&
   [[ $product_name =~ XPS[[:space:]](14|16)|DA(14|16)260 ]] &&
   grep -Eqi 'Intel.*(Ultra|X7)|Panther Lake' /proc/cpuinfo; then
  xps_2026=true
fi

if $xps_2026; then
  pass "precise XPS 2026 hardware gate (SKU $product_sku)"

  panther_packages=(
    alsa-sof-firmware linux-firmware cirrus-audio-firmware
    intel-audio-firmware intel-gpu-firmware intel-vsc-firmware
    iwlwifi-mld-firmware libva-intel-media-driver libvpl intel-vpl-gpu-rt
    wireless-regdb pipewire-module-filter-chain-lv2 lsp-plugins-lv2
  )
  check 'explicit Panther Lake media/firmware RPMs' rpm -q "${panther_packages[@]}"

  check 'XPS speaker tuning user unit is enabled' systemctl --user is-enabled --quiet xps-speaker-tuning.service
  check 'XPS speaker tuning user unit is active' user_unit_active xps-speaker-tuning.service
  check '13-biquad/limiter graph targets only the internal speaker' /usr/local/libexec/xps-speaker-tuning check
  check 'desktop volume controls resolve the tuned physical sink' \
    grep -q '/usr/local/libexec/xps-speaker-tuning control' "$HOME/.config/hypr/bindings.lua"

  if [[ -e /sys/bus/i2c/devices/i2c-VEN_06CB:00 ]]; then
    check 'XPS touchpad is visible to libinput' bash -c "sudo -n libinput list-devices | grep -Eqi 'Touchpad|06CB'"
    check 'XPS haptic touchpad service is enabled' unit_enabled xps-haptic-touchpad.service
    check 'XPS haptic touchpad service is active' unit_active xps-haptic-touchpad.service
    check 'XPS haptic configuration/readback probe' sudo -n /usr/local/libexec/xps-haptic-touchpad --check
    check 'XPS haptic controller power rules retained' \
      grep -q 'i2c_designware[.]0.*power/control.*on' /etc/udev/rules.d/80-xps-haptic-touchpad.rules
  else
    skip 'Synaptics 06CB haptic controller absent; touchpad-specific checks'
  fi

  fingerprint_detector="$repo_root/roles/xps-2026/files/xps-fingerprint-detect"
  if fingerprint_device=$(bash "$fingerprint_detector" 2>/dev/null); then
    pass "physical fingerprint-reader gate ($fingerprint_device)"
    check 'Fedora fingerprint support RPMs' rpm -q libfprint fprintd fprintd-pam
    check_diagnostic 'libfprint-supported device and Fedora PAM integration' \
      /usr/local/libexec/xps-fingerprint-check john
  else
    if lsusb -d 06cb:0701 2>/dev/null | grep -q .; then
      pass 'Synaptics SVP7500 camera bridge is not treated as a fingerprint reader'
    fi
    skip 'no physical fingerprint reader; fingerprint package/PAM checks'
  fi

  has_ovti08f4=false
  [[ -e /sys/bus/acpi/devices/OVTI08F4:00 || -e /sys/bus/acpi/devices/OVTI08F4:01 ]] && has_ovti08f4=true
  has_ipu7=false
  lspci -Dn -d 8086:b05d 2>/dev/null | grep -q '8086:b05d' && has_ipu7=true
  if $has_ovti08f4 && $has_ipu7; then
    check 'local IPU7 userspace/DKMS RPM installed' rpm -q xps-ipu7-camera-stack
    check 'IPU7 PSYS DKMS built for the running kernel' bash -c \
      'dkms status -m ipu7-drivers -k "$(uname -r)" 2>/dev/null | grep -q ": installed$"'
    check 'Intel CVS DKMS built for the running kernel' bash -c \
      'dkms status -m vision-drivers -k "$(uname -r)" 2>/dev/null | grep -q ": installed$"'
    camera_reboot_pending=false
    if [[ -r /var/lib/xps-hardware/ipu7/reboot-required ]] &&
       grep -q "^boot_id=$(cat /proc/sys/kernel/random/boot_id) " \
         /var/lib/xps-hardware/ipu7/reboot-required; then
      camera_reboot_pending=true
      pass 'camera DKMS upgrade is safely awaiting one normal reboot'
      check_diagnostic 'stock IPU7 ABI guard before pending reboot' \
        /usr/local/libexec/xps-ipu7-abi-check "$(uname -r)"
      check_diagnostic 'installed IPU75XA userspace dependency closure' \
        /usr/local/libexec/xps-ipu7-userspace-check
    else
      check_diagnostic 'HAL camera integration and endpoint health' /usr/local/libexec/xps-ipu7-camera-check
    fi
    check 'WirePlumber suppresses only the duplicate IPU7 paths' bash -c \
      'grep -q "monitor.libcamera.*disabled" /etc/wireplumber/wireplumber.conf.d/90-xps-ipu7-v4l2.conf && grep -q "pci-0000:00:05.0" /etc/wireplumber/wireplumber.conf.d/90-xps-ipu7-v4l2.conf'
    check 'Brave enables PipeWire camera capture' bash -c \
      'grep -q "PipeWireCamera" "$HOME/.config/hypr/bindings.lua" && grep -q "PipeWireCamera" "$HOME/.local/share/applications/brave-browser.desktop"'

    if mokutil --sb-state 2>/dev/null | grep -qi enabled; then
      check 'camera module signing key is enrolled for Secure Boot' \
        mokutil --test-key /etc/pki/akmods/certs/public_key.der
      check 'IPU7 PSYS module carries a signature' bash -c \
        '[[ -n $(modinfo -F signer intel_ipu7_psys 2>/dev/null) ]]'
      check 'Intel CVS module carries a signature' bash -c \
        '[[ -n $(modinfo -F signer intel_cvs 2>/dev/null) ]]'
    else
      warn 'Secure Boot is disabled; camera modules are signed but MOK enforcement was not exercised'
    fi
  else
    skip 'OVTI08F4/8086:b05d pair absent; IPU7 camera checks'
  fi

  if command_exists iw && iw dev 2>/dev/null | grep -q '^Interface\|^[[:space:]]*Interface'; then
    regulatory=$(iw reg get 2>/dev/null || true)
    countries=$(sed -n 's/^[[:space:]]*country \([A-Z0-9][A-Z0-9]\):.*/\1/p' <<<"$regulatory")
    if [[ -n $countries ]] && ! grep -qvx NL <<<"$countries"; then
      pass 'effective wireless regulatory domains are NL (DFS-ETSI)'
    else
      fail "wireless regulatory domain is not exclusively NL: ${countries//$'\n'/,}"
    fi
    check 'Fedora timezone-driven regulatory helper is installed' command -v setregdomain
  else
    skip 'wireless interface absent; effective regulatory-domain check'
  fi
else
  skip 'precise Dell XPS 2026 SKU gate not matched; new hardware-role checks'
fi

check 'Cybex Plymouth theme is selected' test "$(plymouth-set-default-theme 2>/dev/null)" = cybex
check 'Cybex theme is embedded in the running-kernel initramfs' bash -c \
  'sudo -n lsinitrd "/boot/initramfs-$(uname -r).img" | grep -q "usr/share/plymouth/themes/cybex/cybex.script"'
check 'GDM retains GNOME session' bash -c 'compgen -G "/usr/share/wayland-sessions/*gnome*.desktop" >/dev/null'
check 'Hyprland Quickshell GDM session exists' test -r /usr/share/wayland-sessions/hyprland-quickshell.desktop
check 'Hyprland session launcher uses start-hyprland' grep -q '^start-hyprland --' /usr/local/bin/hyprland-quickshell
check 'Quickshell Fedora package is installed' rpm -q quickshell
check 'retired Noctalia package is absent' bash -c '! rpm -q noctalia'
check 'retired Noctalia session is absent' bash -c \
  '[[ ! -e /usr/local/bin/hyprland-noctalia && ! -e /usr/share/wayland-sessions/hyprland-noctalia.desktop ]]'
check 'retired Noctalia configuration is inactive' bash -c \
  '[[ ! -e $HOME/.config/noctalia && ! -e $HOME/.local/state/noctalia ]]'
if grep -Eq '^AutomaticLoginEnable=True$' /etc/gdm/custom.conf 2>/dev/null; then
  check 'GDM autologin Session selects Hyprland Quickshell' \
    sudo -n grep -qx 'Session=hyprland-quickshell' /var/lib/AccountsService/users/john
  check 'GDM autologin XSession selects Hyprland Quickshell' \
    sudo -n grep -qx 'XSession=hyprland-quickshell' /var/lib/AccountsService/users/john
fi
check 'no Hyprland git packages are installed' bash -c "! rpm -qa | grep -Eq '^(hyprland|hypridle|hyprlock|hyprpicker|hyprpolkitagent).*[-.]git([-.]|$)'"
check 'portal preference exists' test -r "$HOME/.config/xdg-desktop-portal/hyprland-portals.conf"
check 'Hyprland Lua entry point is a regular file' bash -c '[[ -f $HOME/.config/hypr/hyprland.lua && ! -L $HOME/.config/hypr/hyprland.lua ]]'

for command in Hyprland start-hyprland hypridle hyprlock hyprpicker satty qs qalc cliphist \
  wayfreeze awww voxtype localsend lazygit lazydocker mdview bun balena t3code-update \
  git gh gcc g++ cmake rustup mold sccache node npm python3 distrobox docker podman \
  kitty nvim fish zoxide fzf eza jq rg fd dust bat btop glow fastfetch duf ffmpeg mpv yt-dlp imv brave-browser; do
  command_exists "$command" && pass "command: $command" || fail "missing command: $command"
done
check 'Walker command is absent' bash -c '! command -v walker'
check 'Elephant command is absent' bash -c '! command -v elephant'
check 'Walker user unit is absent' bash -c '! systemctl --user list-unit-files walker.service --no-legend 2>/dev/null | grep -q walker'
check 'Elephant user unit is absent' bash -c '! systemctl --user list-unit-files elephant.service --no-legend 2>/dev/null | grep -q elephant'
if command_exists hyprpolkitagent || [[ -x /usr/libexec/hyprpolkitagent ]]; then
  pass 'Hyprland Polkit agent executable'
else
  fail 'missing Hyprland Polkit agent executable'
fi

if command_exists node; then
  major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)
  [[ $major == 24 ]] && pass 'Node.js 24' || fail "Node.js major is ${major:-unknown}, expected 24"
fi
check 'nightly Rust toolchain with rustfmt/rust-analyzer' bash -c 'rustup toolchain list | grep -q "nightly" && rustup component list --toolchain nightly | grep -q "rustfmt.*installed" && rustup component list --toolchain nightly | grep -q "rust-analyzer.*installed"'
check 'Android sdkmanager' test -x "$HOME/Android/Sdk/cmdline-tools/latest/bin/sdkmanager"
check 'Android platform-tools' test -x "$HOME/Android/Sdk/platform-tools/adb"

check 'Brave restore, Dutch spellcheck, and 1Password policy' \
  jq -e '.RestoreOnStartup == 1 and .SpellcheckLanguage == ["nl"] and (.ExtensionInstallForcelist | length == 1)' \
  /etc/brave/policies/managed/xps.json
check 'Brave launchers automatically restore after an unclean exit' bash -c \
  'grep -q -- "--restore-last-session --hide-crash-restore-bubble" "$HOME/.config/hypr/bindings.lua" && grep -q -- "--restore-last-session --hide-crash-restore-bubble" "$HOME/.local/share/applications/brave-browser.desktop"'
check 'Firefox 1Password policy' jq -e '.policies.ExtensionSettings["{d634138d-c276-4fc8-924b-40a0ea21d284}"].installation_mode == "force_installed"' /usr/lib64/firefox/distribution/policies.json
check 'Brave is the effective default HTTPS handler' bash -c \
  '[[ $(xdg-mime query default x-scheme-handler/https) == brave-browser.desktop ]]'
check 'retired Google Chrome package is absent' bash -c '! rpm -q google-chrome-stable >/dev/null 2>&1'
check 'T3 Code OAuth callback dependencies are installed' rpm -q xdg-utils fuse-libs
check 'T3 Code Nightly desktop file advertises its OAuth callback' \
  grep -qx 'MimeType=x-scheme-handler/t3code;' \
  "$HOME/.local/share/applications/t3code-nightly.desktop"
check 'T3 Code Nightly receives OAuth callbacks' bash -c '
  handler=$(xdg-mime query default x-scheme-handler/t3code)
  if [[ $handler == t3code-nightly.desktop ]]; then
    exit 0
  fi
  [[ $handler == t3code-url-handler.desktop ]] || exit 1
  generated=$HOME/.local/share/applications/t3code-url-handler.desktop
  grep -qx "MimeType=x-scheme-handler/t3code;" "$generated" &&
    grep -Eq "^Exec=\"?.*/t3code-nightly/T3-Code-Nightly-x86_64[.]AppImage\"? %U$" "$generated"
'
check 'T3 Code development callbacks are not claimed by Nightly' bash -c \
  '[[ $(xdg-mime query default x-scheme-handler/t3code-dev) != t3code-nightly.desktop ]]'
if [[ -d $HOME/.config/mozilla/firefox || -d $HOME/.mozilla/firefox ]]; then
  pass 'existing Firefox profile is present'
else
  warn 'Firefox profile is not present yet (no legacy backup was restored)'
fi

check 'Docker daemon responds as john' sg docker -c 'docker info'
check 'rootless Podman responds' podman info
check 'Steam 32-bit Mesa is installed' rpm -q mesa-dri-drivers.i686 mesa-vulkan-drivers.i686
for launcher in fedora arch debian; do
  check "Distrobox $launcher launcher syntax" bash -n "$HOME/.local/bin/dev-$launcher-shell"
done

if [[ ${XDG_CURRENT_DESKTOP:-} == *Hyprland* ]] && command_exists hyprctl && hyprctl monitors >/dev/null 2>&1; then
  errors=$(hyprctl configerrors 2>/dev/null || true)
  [[ -z $errors || $errors == 'no errors' ]] && pass 'Hyprland has no config errors' || fail "Hyprland config errors: $errors"
  check 'retired Noctalia process is absent' bash -c '! pgrep -x noctalia'
  for unit in quickshell hypridle hyprpolkitagent voxtype external-monitor-toggle; do
    check "user unit active: $unit" user_unit_active "$unit.service"
  done
  quickshell_invocation=$(systemctl --user show -p InvocationID --value quickshell.service 2>/dev/null || true)
  quickshell_log=$(journalctl --user "_SYSTEMD_INVOCATION_ID=$quickshell_invocation" --no-pager 2>/dev/null || true)
  if [[ -n $quickshell_invocation ]] && grep -Eqi 'Failed to load|Syntax error|Cannot open|Binding loop|invalid (width|height|size)|larger than the maximum texture size|requested buffer size is too big|oversized' <<<"$quickshell_log"; then
    fail 'Quickshell loaded its configuration without errors'
  else
    pass 'Quickshell loaded its configuration without errors'
  fi
  check 'Quickshell launcher IPC responds' qs ipc call launcher close
  check 'Quickshell settings IPC responds' qs ipc call settings close
  check 'portal service active' user_unit_active xdg-desktop-portal.service
  check 'Hyprland portal active' user_unit_active xdg-desktop-portal-hyprland.service
  check 'Quickshell notification service owns the desktop bus name' \
    busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
      org.freedesktop.DBus GetNameOwner s org.freedesktop.Notifications
  check 'Secret Service responds in Hyprland' \
    gdbus call --session --dest org.freedesktop.secrets \
      --object-path /org/freedesktop/secrets --method org.freedesktop.DBus.Peer.Ping
  monitors=$(hyprctl monitors -j 2>/dev/null || echo '[]')
  jq -e '.[] | select(.name == "eDP-1") | .refreshRate >= 119' <<<"$monitors" >/dev/null \
    && pass 'internal panel is running at 120 Hz' || warn 'internal panel is not currently visible at 120 Hz'
else
  $require_hyprland && fail 'verification must be run inside a Hyprland session' \
    || warn 'Hyprland runtime checks skipped outside a Hyprland session'
fi

check 'PipeWire audio graph responds' wpctl status
command_exists v4l2-ctl && v4l2-ctl --list-devices >/dev/null 2>&1 \
  && pass 'camera device is visible' || warn 'camera device not automatically verified'
systemctl is-active --quiet intel_lpmd.service && pass 'intel-lpmd active' || warn 'intel-lpmd service is not active/available'
systemctl is-active --quiet thermald.service && pass 'thermald active' || fail 'thermald inactive'

printf '\nManual acceptance still required (these checks are intentionally non-destructive):\n'
printf '%s\n' \
  '  - Quickshell launcher modes/navigation, notification toasts/actions/DND, Polkit, Secret Service, screenshots, recording, OCR, and dictation' \
  '  - focused-monitor bar migration, launcher placement, responsive widths, audio wheel/mute, and popout hover switching' \
  '  - T3 Code dropdown row expand/collapse and selection across needs-you, running, plan-ready, completed, idle, and failed sections; one inspector/subscription, bounded scrolling, explicit open links, Stop, per-thread/bulk Mark reviewed, and unchanged chip/count/tooltip/notifications' \
  '  - T3 Code approval and follow-up sending/failure feedback plus structured-input single-select, multi-select, custom, Back/Next/Submit, multi-question completeness, retry draft retention, and resolution cleanup' \
  '  - lid close/open and Apple/AORUS/XREAL hotplug behavior' \
  '  - touchpad/haptics, Wi-Fi 7 throughput, audio, Snapshot/video-call camera, and mic LED' \
  '  - fan response under load, suspend/resume, docked-lid behavior, LocalSend transfer, and Steam launch' \
  '  - every GUI desktop entry and all three lazy-created Distroboxes'

printf '\nResult: %d failure(s), %d warning(s).\n' "$failures" "$warnings"
(( failures == 0 ))
