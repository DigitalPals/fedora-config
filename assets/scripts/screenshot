#!/bin/bash
# Screenshot capture with optional Satty editing
# Usage: screenshot [region|fullscreen]

OUTPUT_DIR="$HOME/Pictures/Screenshots"
mkdir -p "$OUTPUT_DIR"

# Cancel any existing slurp
pkill slurp && exit 0

MODE="${1:-region}"
TS="$(date +'%Y-%m-%d_%H-%M-%S')"
OUTPUT_FILE="$OUTPUT_DIR/screenshot-${TS}.png"
FREEZE_PID=""
CAPTURED=0
NO_HW_CURSORS=""
CURSOR_SETTING_CHANGED=0

set_no_hw_cursors() {
  hyprctl eval "hl.config({ cursor = { no_hardware_cursors = $1 } })" &>/dev/null ||
    hyprctl keyword cursor:no_hardware_cursors "$1" &>/dev/null
}

cleanup_freeze() {
  if [ -n "${FREEZE_PID:-}" ]; then
    kill "$FREEZE_PID" 2>/dev/null || true
    wait "$FREEZE_PID" 2>/dev/null || true
    FREEZE_PID=""
  fi
}

cleanup() {
  cleanup_freeze

  if [ "$CURSOR_SETTING_CHANGED" -eq 1 ]; then
    set_no_hw_cursors "$NO_HW_CURSORS" || true
    CURSOR_SETTING_CHANGED=0
  fi
}

trap cleanup EXIT

# grim omits hardware cursors, while software-composited cursors can already be
# baked into captured frames. Force hardware composition for the capture and
# restore the user's setting on every exit path, as Omarchy does.
NO_HW_CURSORS=$(hyprctl getoption cursor:no_hardware_cursors -j | jq -r '.int') || exit 1
[[ $NO_HW_CURSORS =~ ^[0-9]+$ ]] || exit 1
CURSOR_SETTING_CHANGED=1
set_no_hw_cursors 0 || exit 1

edit_screenshot() {
  satty --filename "$1" \
    --output-filename "$1" \
    --early-exit \
    --actions-on-enter save-to-clipboard \
    --save-after-copy \
    --copy-command "$HOME/.local/bin/clipboard-copy-image"
}

offer_edit() {
  command -v notify-send >/dev/null 2>&1 || return 0

  # notify-send waits for the default action in this background subshell. The
  # Quickshell notification server maps that action to a click on the card.
  (
    action=$(notify-send \
      --app-name="Screenshot" \
      --icon="$1" \
      --action="default=Edit screenshot" \
      "Screenshot saved to clipboard and file" \
      "Click to edit in Satty" 2>/dev/null) || exit 0
    [ "$action" = "default" ] && edit_screenshot "$1"
  ) &
}

case "$MODE" in
  fullscreen)
    SELECTION=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | "\(.x),\(.y) \((.width / .scale) | floor)x\((.height / .scale) | floor)"')
    ;;
  region|*)
    # wayfreeze otherwise requests that the compositor copy the cursor into
    # its frozen layer, where grim can no longer distinguish it from pixels.
    wayfreeze --hide-cursor & FREEZE_PID=$!
    sleep 0.1
    SELECTION=$(slurp 2>/dev/null || true)
    if [ -n "$SELECTION" ]; then
      if grim -g "$SELECTION" "$OUTPUT_FILE"; then
        CAPTURED=1
      else
        cleanup_freeze
        exit 1
      fi
    fi
    cleanup_freeze
    ;;
esac

[ -z "$SELECTION" ] && exit 0

if [ "$CAPTURED" -eq 0 ]; then
  grim -g "$SELECTION" "$OUTPUT_FILE" || exit 1
fi

wl-copy --type image/png < "$OUTPUT_FILE" || exit 1
offer_edit "$OUTPUT_FILE"
