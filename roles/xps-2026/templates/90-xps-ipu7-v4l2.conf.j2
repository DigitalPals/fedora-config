# Hide the unusable raw ISYS nodes. The generic libcamera pipeline can discover
# OV08X40 but cannot use Intel's proprietary IPU7 processing graph, so exposing
# it creates a duplicate, broken default camera. The HAL-backed v4l2loopback
# endpoint remains visible to PipeWire and ordinary USB V4L2 cameras are not
# affected.
wireplumber.profiles = {
  main = {
    "monitor.libcamera" = disabled
  }
}

monitor.v4l2.rules = [
  {
    matches = [
      { device.bus-path = "pci-{{ xps_2026_ipu7_pci_bdf }}" }
    ]
    actions = {
      update-props = { device.disabled = true }
    }
  }
]
