#!/usr/bin/env bash
set -euo pipefail

user=${1:-}
[[ -n $user ]] || {
  echo 'usage: xps-fingerprint-check USER' >&2
  exit 2
}
getent passwd "$user" >/dev/null || {
  echo "local user does not exist: $user" >&2
  exit 1
}

for package in libfprint fprintd fprintd-pam; do
  rpm -q "$package" >/dev/null || {
    echo "fingerprint support package is missing: $package" >&2
    exit 1
  }
done
systemctl cat fprintd.service >/dev/null || {
  echo 'fprintd D-Bus service unit is unavailable' >&2
  exit 1
}

manager_output=$(busctl call --system \
  net.reactivated.Fprint \
  /net/reactivated/Fprint/Manager \
  net.reactivated.Fprint.Manager \
  GetDevices 2>&1) || {
    echo "fprintd did not answer over D-Bus: $manager_output" >&2
    exit 1
  }

if [[ ! $manager_output =~ ^ao[[:space:]]+([1-9][0-9]*)[[:space:]] ]]; then
  echo 'libfprint/fprintd found no supported fingerprint device' >&2
  exit 1
fi

device_count=${BASH_REMATCH[1]}
authselect_state=$(authselect current --raw 2>&1) || {
  echo "authselect configuration is not readable: $authselect_state" >&2
  exit 1
}
if [[ " $authselect_state " != *' with-fingerprint '* ]]; then
  echo 'fprintd sees a device, but authselect has not enabled with-fingerprint' >&2
  exit 1
fi
authselect check >/dev/null || {
  echo 'authselect reports an invalid managed PAM configuration' >&2
  exit 1
}
grep -q 'pam_fprintd[.]so' /etc/pam.d/system-auth || {
  echo 'Fedora system-auth does not include pam_fprintd' >&2
  exit 1
}
grep -q 'pam_unix[.]so' /etc/pam.d/system-auth || {
  echo 'Fedora system-auth lost its password fallback' >&2
  exit 1
}

# Query device properties, not enrolled fingers. This proves current libfprint
# claimed a supported device while remaining valid before manual enrollment.
mapfile -t device_paths < <(grep -o '"/net/reactivated/Fprint/Device/[^"]*"' \
  <<<"$manager_output" | tr -d '"')
[[ ${#device_paths[@]} -eq $device_count ]] || {
  echo "fprintd returned an unparsable device list: $manager_output" >&2
  exit 1
}
names=()
for device_path in "${device_paths[@]}"; do
  device_name=$(busctl get-property --system net.reactivated.Fprint \
    "$device_path" net.reactivated.Fprint.Device name 2>&1) || {
      echo "fprintd device property query failed: $device_name" >&2
      exit 1
    }
  names+=("${device_name#s }")
done

printf 'supported_devices=%s user=%s names=%s\n' \
  "$device_count" "$user" "${names[*]}"
