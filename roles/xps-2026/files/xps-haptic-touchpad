#!/usr/bin/python3
"""Keep the Dell XPS 2026 Synaptics haptic feature state applied."""

import argparse
import errno
import fcntl
import glob
import os
import select
import signal
import struct
import sys
import time


VENDOR = "06CB"
CONFIG_PATH = "/etc/xps-haptic-touchpad.conf"
BUTTON_SWITCH_REPORT = 0x06
HAPTIC_INTENSITY_REPORT = 0x37
BUTTON_SWITCHES = 0x03  # Surface switch and physical button switch.
DEFAULT_INTENSITY = 100
VALID_INTENSITIES = {10, 50, 100}

EV_KEY = 0x01
PHYSICAL_BUTTONS = {0x110, 0x111, 0x112}  # BTN_LEFT/RIGHT/MIDDLE
EVENT_FORMAT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
READBACK_UNSUPPORTED = {
    errno.EINVAL,
    errno.ENOTTY,
    errno.EOPNOTSUPP,
    errno.EREMOTEIO,
}
POWER_CONTROL_PATHS = (
    "/sys/bus/pci/devices/0000:00:19.0/power/control",
    "/sys/bus/platform/devices/i2c_designware.0/power/control",
)

stop_requested = False
reload_requested = False


def hid_feature_ioctl(operation, length):
    return 0xC0000000 | (length << 16) | (ord("H") << 8) | operation


def read_uevent(path):
    values = {}
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                key, _, value = line.strip().partition("=")
                if key:
                    values[key] = value
    except OSError:
        pass
    return values


def find_touchpad_event():
    for path in sorted(glob.glob("/sys/class/input/event*/device/name")):
        try:
            with open(path, encoding="utf-8") as handle:
                name = handle.read().strip().upper()
            if VENDOR not in name or "TOUCHPAD" not in name:
                continue
            device_dir = os.path.dirname(path)
            values = read_uevent(os.path.join(device_dir, "uevent"))
            event = path.split("/")[-3]
            return os.path.join("/dev/input", event), values.get("PHYS"), name
        except OSError:
            continue
    return None, None, None


def find_hidraw(phys):
    candidates = []
    for path in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        values = read_uevent(os.path.join(path, "device", "uevent"))
        if f"0000{VENDOR}" not in values.get("HID_ID", "").upper():
            continue
        device = os.path.join("/dev", os.path.basename(path))
        candidates.append((device, values.get("HID_PHYS")))
        if phys and values.get("HID_PHYS") == phys:
            return device
    # A unique Synaptics hidraw node is safe when this kernel omits HID_PHYS.
    return candidates[0][0] if len(candidates) == 1 else None


def find_devices(timeout=15):
    deadline = time.monotonic() + timeout
    while not stop_requested and time.monotonic() < deadline:
        event, phys, name = find_touchpad_event()
        hidraw = find_hidraw(phys) if event else None
        if event and hidraw:
            return event, hidraw, phys, name
        time.sleep(0.5)
    return None, None, None, None


def keep_controller_awake():
    paths = list(POWER_CONTROL_PATHS)
    paths.extend(glob.glob("/sys/bus/i2c/devices/i2c-VEN_06CB:*/power/control"))
    for path in paths:
        try:
            with open(path, "w", encoding="ascii") as handle:
                handle.write("on\n")
        except OSError as error:
            print(f"Could not keep {path} awake: {error}", file=sys.stderr)


def configured_intensity():
    intensity = DEFAULT_INTENSITY
    try:
        with open(CONFIG_PATH, encoding="ascii") as handle:
            for line in handle:
                key, separator, value = line.strip().partition("=")
                if separator and key == "INTENSITY":
                    intensity = int(value)
    except (OSError, ValueError) as error:
        print(f"Using default haptic intensity: {error}", file=sys.stderr)
        intensity = DEFAULT_INTENSITY
    if intensity not in VALID_INTENSITIES:
        raise ValueError(f"INTENSITY must be one of {sorted(VALID_INTENSITIES)}")
    return intensity


def set_feature(fd, report_id, value):
    report = struct.pack("BB", report_id, value)
    fcntl.ioctl(fd, hid_feature_ioctl(0x06, len(report)), report)


def get_feature(fd, report_id):
    report = bytearray((report_id, 0))
    fcntl.ioctl(fd, hid_feature_ioctl(0x07, len(report)), report, True)
    return report[1]


def readback(fd, expected):
    observed = {}
    for report_id, value in expected.items():
        try:
            observed[report_id] = get_feature(fd, report_id)
        except OSError as error:
            if error.errno in READBACK_UNSUPPORTED:
                return None
            raise
        if observed[report_id] != value:
            raise RuntimeError(
                f"feature 0x{report_id:02x} read back as {observed[report_id]}, expected {value}"
            )
    return observed


def apply_features(fd, intensity):
    expected = {
        BUTTON_SWITCH_REPORT: BUTTON_SWITCHES,
        HAPTIC_INTENSITY_REPORT: intensity,
    }
    for report_id, value in expected.items():
        set_feature(fd, report_id, value)
    return readback(fd, expected)


def check_devices():
    event, hidraw, phys, name = find_devices(timeout=3)
    if not event or not hidraw:
        print("Synaptics haptic touchpad pair was not found", file=sys.stderr)
        return 1
    intensity = configured_intensity()
    with open(hidraw, "rb+", buffering=0) as handle:
        try:
            values = readback(
                handle.fileno(),
                {
                    BUTTON_SWITCH_REPORT: BUTTON_SWITCHES,
                    HAPTIC_INTENSITY_REPORT: intensity,
                },
            )
        except RuntimeError as error:
            print(f"{event} <-> {hidraw} ({phys}): {error}", file=sys.stderr)
            return 1
    status = "unsupported (write-only HID transport)" if values is None else "verified"
    print(
        f"event={event} hidraw={hidraw} phys={phys} name={name} "
        f"switches={BUTTON_SWITCHES} intensity={intensity} readback={status}"
    )
    return 0


def monitor_pair(event, hidraw, phys):
    global reload_requested
    intensity = configured_intensity()
    event_fd = os.open(event, os.O_RDONLY | os.O_NONBLOCK)
    hidraw_fd = os.open(hidraw, os.O_RDWR)
    poller = select.poll()
    poller.register(event_fd, select.POLLIN | select.POLLERR | select.POLLHUP | select.POLLNVAL)
    try:
        values = apply_features(hidraw_fd, intensity)
        readback_status = "verified" if values is not None else "unsupported"
        print(
            f"Haptic touchpad: hidraw={hidraw} input={event} phys={phys} "
            f"switches={BUTTON_SWITCHES} intensity={intensity} readback={readback_status}",
            flush=True,
        )
        config_mtime = os.path.getmtime(CONFIG_PATH) if os.path.exists(CONFIG_PATH) else None

        while not stop_requested:
            events = poller.poll(1000)
            current_mtime = os.path.getmtime(CONFIG_PATH) if os.path.exists(CONFIG_PATH) else None
            if reload_requested or current_mtime != config_mtime:
                reload_requested = False
                config_mtime = current_mtime
                intensity = configured_intensity()
                apply_features(hidraw_fd, intensity)
                print(f"Reapplied configured haptic intensity={intensity}", flush=True)

            for _, flags in events:
                if flags & (select.POLLERR | select.POLLHUP | select.POLLNVAL):
                    raise OSError(errno.ENODEV, "touchpad disappeared")
                try:
                    data = os.read(event_fd, EVENT_SIZE * 32)
                except BlockingIOError:
                    continue
                for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                    _, _, event_type, code, value = struct.unpack(
                        EVENT_FORMAT, data[offset : offset + EVENT_SIZE]
                    )
                    if event_type == EV_KEY and code in PHYSICAL_BUTTONS and value in (0, 1):
                        # Some controller resets first show up as a dead click.
                        apply_features(hidraw_fd, intensity)
    finally:
        os.close(event_fd)
        os.close(hidraw_fd)


def request_stop(_signum, _frame):
    global stop_requested
    stop_requested = True


def request_reload(_signum, _frame):
    global reload_requested
    reload_requested = True


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true", help="verify pairing and HID readback")
    args = parser.parse_args()
    if args.check:
        return check_devices()

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    signal.signal(signal.SIGHUP, request_reload)

    while not stop_requested:
        keep_controller_awake()
        event, hidraw, phys, _ = find_devices()
        if not event or not hidraw:
            print("Synaptics haptic touchpad pair has not appeared; retrying", file=sys.stderr)
            time.sleep(3)
            continue
        try:
            monitor_pair(event, hidraw, phys)
        except (OSError, RuntimeError, ValueError) as error:
            print(f"Touchpad needs re-enumeration/reapply: {error}", file=sys.stderr)
            time.sleep(1)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
