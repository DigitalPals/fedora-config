#!/usr/bin/bash
set -euo pipefail

die() {
  echo "xps-ipu7-camera-init: $*" >&2
  exit 1
}

assert_committed_transaction() {
  local actual committed
  [[ ! -e /var/lib/xps-hardware/ipu7/transaction.in-progress ]] \
    || die 'the camera package transaction is incomplete; rerun the camera role'
  [[ -r /var/lib/xps-hardware/ipu7/committed-identity ]] \
    || die 'the installed camera package has no verified committed identity'
  committed=$(</var/lib/xps-hardware/ipu7/committed-identity)
  [[ $committed =~ ^manifest=[[:xdigit:]]{64}$ ||
     $committed =~ ^nevra=[^[:cntrl:]]+$ ]] \
    || die 'the committed camera package identity is malformed'
  actual=$(/usr/local/libexec/xps-ipu7-build installed-identity) \
    || die 'the installed camera package identity cannot be read'
  [[ $actual == "$committed" ]] \
    || die 'the installed camera package does not match its committed identity'
}

[[ $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) == 'Dell Inc.' ]] || die 'not a Dell system'
case "$(cat /sys/class/dmi/id/product_sku 2>/dev/null)" in
  0DB9|0DBA) ;;
  *) die 'DMI SKU is not a supported XPS 2026 model' ;;
esac
[[ -e /sys/bus/acpi/devices/OVTI08F4:00 || -e /sys/bus/acpi/devices/OVTI08F4:01 ]] \
  || die 'OVTI08F4 ACPI camera is absent'
ipu7_bdf=""
for pci_device in /sys/bus/pci/devices/*; do
  [[ $(cat "$pci_device/vendor" 2>/dev/null) == 0x8086 \
     && $(cat "$pci_device/device" 2>/dev/null) == 0xb05d ]] || continue
  ipu7_bdf=${pci_device##*/}
  break
done
[[ -n $ipu7_bdf ]] || die 'Panther Lake IPU7 PCI function (8086:b05d) is absent'

assert_committed_transaction

/usr/local/libexec/xps-ipu7-build validate-installed "$(uname -r)" >/dev/null \
  || die 'the committed camera RPM, userspace, or DKMS identity is no longer exact'

reboot_marker=/var/lib/xps-hardware/ipu7/reboot-required
if [[ -r $reboot_marker ]]; then
  current_boot=$(cat /proc/sys/kernel/random/boot_id)
  if grep -q "^boot_id=$current_boot " "$reboot_marker"; then
    die 'new DKMS modules are installed; reboot once before starting the camera'
  fi
  unlink "$reboot_marker"
fi

if journalctl -k -b --no-pager 2>/dev/null | grep -Eq 'RIP: .*ipu7|BUG:.*ipu7'; then
  die 'this boot already recorded an IPU7 kernel fault; reboot before retrying the camera'
fi

# Close the small race with an Ansible refresh beginning while this oneshot was
# running. The transaction marker is durable before DNF and the role stops this
# unit, but this second check also refuses module exposure before that stop wins.
assert_committed_transaction

# On the first managed start an earlier automatic probe may have bound the
# sensor before CVS owned its USBIO power path. Rebind it once in the correct
# order. Failure is explicit and recoverable with a reboot; no IPU base driver
# is ever unloaded or replaced.
if grep -q '^ov08x40 ' /proc/modules && ! grep -q '^intel_cvs ' /proc/modules; then
  systemctl stop v4l2-relayd@ipu7.service >/dev/null 2>&1 || true
  modprobe -r ov08x40 || die 'ov08x40 is busy; reboot once to apply CVS-first ordering'
fi

modprobe intel_cvs
sleep 2
modprobe ov08x40
modprobe intel_ipu7_psys

# Reload only a stale loopback instance with the wrong label. Fedora's native
# akmod remains the owner of this module.
if grep -q '^v4l2loopback ' /proc/modules &&
   ! grep -Rqs '^Hardware ISP Camera$' /sys/devices/virtual/video4linux/*/name 2>/dev/null; then
  systemctl stop v4l2-relayd@ipu7.service >/dev/null 2>&1 || true
  modprobe -r v4l2loopback || die 'v4l2loopback is busy with stale options; reboot once'
fi
modprobe v4l2loopback
udevadm settle --timeout=10

for _ in {1..30}; do
  [[ -e /dev/ipu7-psys0 || -e /dev/ipu-psys0 ]] && break
  sleep 0.2
done
[[ -e /dev/ipu7-psys0 || -e /dev/ipu-psys0 ]] || die 'IPU7 PSYS device did not appear'

for _ in {1..30}; do
  [[ -r /sys/class/video4linux/video50/name ]] &&
    grep -Fxq 'Hardware ISP Camera' /sys/class/video4linux/video50/name && break
  sleep 0.2
done
grep -Fxq 'Hardware ISP Camera' /sys/class/video4linux/video50/name 2>/dev/null \
  || die 'the managed /dev/video50 loopback endpoint did not appear'
