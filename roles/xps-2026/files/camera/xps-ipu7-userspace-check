#!/usr/bin/env python3
"""Validate the minimal IPU75XA HAL/GStreamer runtime dependency closure."""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path


class Incomplete(RuntimeError):
    pass


NEEDED_RE = re.compile(r"\(NEEDED\).*Shared library: \[([^]]+)]")
LDD_RE = re.compile(r"^\s*(\S+)\s+=>\s+(\S+)")


def private_soname(name: str) -> bool:
    return (
        (name.startswith("libia_") and "-ipu75xa.so" in name)
        or name.startswith("libcamhal.so")
        or name.startswith("libgsticamerainterface-1.0.so")
    )


def under(path: Path, directory: Path) -> bool:
    try:
        path.resolve().relative_to(directory.resolve())
    except ValueError:
        return False
    return True


def run_elf_check(path: Path, libdir: Path, staged: bool) -> set[str]:
    readelf = subprocess.run(
        ["readelf", "-d", str(path)], check=False, capture_output=True, text=True
    )
    if readelf.returncode:
        raise Incomplete(f"readelf rejected {path}: {readelf.stderr.strip()}")
    needed = {
        match.group(1)
        for match in map(NEEDED_RE.search, readelf.stdout.splitlines())
        if match
    }

    environment = os.environ.copy()
    environment["LD_LIBRARY_PATH"] = str(libdir)
    ldd = subprocess.run(
        ["ldd", str(path)],
        check=False,
        capture_output=True,
        text=True,
        env=environment,
    )
    ldd_output = f"{ldd.stdout}\n{ldd.stderr}"
    if ldd.returncode or "not found" in ldd_output:
        missing = [
            line.strip() for line in ldd_output.splitlines() if "not found" in line
        ]
        detail = ", ".join(missing) or ldd_output.strip()
        raise Incomplete(f"unresolved dependency for {path}: {detail}")

    resolved = {}
    for line in ldd.stdout.splitlines():
        if match := LDD_RE.match(line):
            resolved[match.group(1)] = match.group(2)
    for soname in needed:
        if not private_soname(soname):
            continue
        provided = libdir / soname
        if not provided.exists():
            raise Incomplete(f"private dependency {soname} needed by {path} is absent")
        if staged:
            loaded = resolved.get(soname)
            if loaded is None or loaded == "not" or not under(Path(loaded), libdir):
                raise Incomplete(
                    f"{path} resolved private dependency {soname} outside the staged package: {loaded}"
                )
    return needed


def require_files(root: Path) -> tuple[list[Path], Path]:
    libdir = root / "usr/lib64"
    categories = {
        "libcamhal": list(libdir.glob("libcamhal.so*")),
        "HAL plugin": list((libdir / "libcamhal/plugins").glob("*")),
        "icamerasrc": list((libdir / "gstreamer-1.0").glob("libgsticamerasrc.so*")),
        "IPU75XA binary libraries": list(libdir.glob("libia_*-ipu75xa.so*")),
    }
    checked: dict[Path, Path] = {}
    for label, candidates in categories.items():
        files = [path for path in candidates if path.is_file()]
        if not files:
            raise Incomplete(f"no {label} artifacts found under {libdir}")
        for path in files:
            checked[path.resolve()] = path

    interface = list(libdir.glob("libgsticamerainterface-1.0.so*"))
    if not any(path.is_file() for path in interface):
        raise Incomplete("icamerasrc private interface library is absent")
    for path in interface:
        if path.is_file():
            checked[path.resolve()] = path
    return list(checked.values()), libdir


def check_config(root: Path) -> int:
    config = root / "etc/camera/ipu75xa"
    required = (
        config / "libcamhal_configs.json",
        config / "pipe_scheduler_profiles.json",
        config / "pnp_profiles.json",
        config / "sensors/ov08x40-uf.json",
        config / "OV08X40_KAFE799_PTL.aiqb",
        config / "gcss/OV08X40_KAFE799.IPU75XA.bin",
    )
    missing = [
        str(path) for path in required if not path.is_file() or not path.stat().st_size
    ]
    if missing:
        raise Incomplete(f"required OV08X40 HAL config/data is missing: {', '.join(missing)}")
    for path in required[:4]:
        try:
            content = path.read_text()
        except (OSError, UnicodeDecodeError) as error:
            raise Incomplete(f"unreadable HAL configuration {path}: {error}") from error
        # Intel's files are JSON-with-comments (and contain trailing commas),
        # so a strict JSON parser would reject valid HAL input. Check their
        # basic object shape and target sensor identity without rewriting them.
        if "{" not in content or "}" not in content:
            raise Incomplete(f"HAL configuration has no object body: {path}")
    if (
        "ov08x40-uf" not in required[0].read_text()
        or "ov08x40" not in required[3].read_text()
    ):
        raise Incomplete("HAL configuration does not declare the OV08X40 user-facing sensor")
    return sum(1 for path in config.rglob("*") if path.is_file() and path.stat().st_size)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path("/"))
    args = parser.parse_args()
    root = args.root.resolve()
    try:
        artifacts, libdir = require_files(root)
        staged = root != Path("/")
        for artifact in artifacts:
            run_elf_check(artifact, libdir, staged)
        config_count = check_config(root)
    except Incomplete as error:
        print(f"IPU7_USERSPACE_INCOMPLETE: {error}", file=sys.stderr)
        return 1
    print(
        f"IPU7_USERSPACE_OK elf_artifacts={len(artifacts)} "
        f"config_files={config_count}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
