#!/usr/bin/bash
# Stop the userspace relay before suspend; restarting kernel IPU7 modules in a
# sleep hook is intentionally avoided because it makes stock-kernel PM fragile.
case "${1:-}" in
  pre)
    # Cancel a prior delayed resume before stopping the relay. This makes an
    # immediate second suspend, including suspend-then-hibernate, idempotent.
    systemctl stop xps-ipu7-camera-resume.service >/dev/null 2>&1 || true
    systemctl stop v4l2-relayd@ipu7.service >/dev/null 2>&1 || true
    ;;
  post)
    systemctl reset-failed xps-ipu7-camera-resume.service >/dev/null 2>&1 || true
    systemctl --no-block restart xps-ipu7-camera-resume.service >/dev/null 2>&1 || true
    ;;
esac
exit 0
