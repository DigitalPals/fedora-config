#!/usr/bin/bash
set -uo pipefail

failures=0
pass() { printf 'PASS  %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*" >&2; failures=$((failures + 1)); }
check() {
  local label=$1
  shift
  if "$@" >/dev/null 2>&1; then pass "$label"; else fail "$label"; fi
}
check_diagnostic() {
  local label=$1 output
  shift
  if output=$("$@" 2>&1); then
    pass "$label"
  else
    fail "$label"
    sed 's/^/      /' <<<"$output" >&2
  fi
}

check 'Dell XPS 2026 camera SKU' bash -c "grep -Eq '^(0DB9|0DBA)$' /sys/class/dmi/id/product_sku"
check 'OVTI08F4 ACPI camera' bash -c 'test -e /sys/bus/acpi/devices/OVTI08F4:00 || test -e /sys/bus/acpi/devices/OVTI08F4:01'
check 'Panther Lake IPU7 PCI ID' bash -c "lspci -Dn -d 8086:b05d | grep -q '8086:b05d'"
check 'Fedora-owned Panther Lake IPU7 firmware' bash -c \
  'test -r /usr/lib/firmware/intel/ipu/ipu7ptl_fw.bin || test -r /usr/lib/firmware/intel/ipu/ipu7ptl_fw.bin.xz'
check 'Fedora stock intel_ipu7 base module retained' bash -c "modinfo -n intel_ipu7 | grep -q '/kernel/'"
check 'Fedora stock intel_ipu7_isys module retained' bash -c "modinfo -n intel_ipu7_isys | grep -q '/kernel/'"
check_diagnostic 'Fedora stock IPU7 private ABI matches reviewed PSYS layout' \
  /usr/local/libexec/xps-ipu7-abi-check "$(uname -r)"
check_diagnostic 'minimal IPU75XA ELF/config dependency closure' \
  /usr/local/libexec/xps-ipu7-userspace-check
for module in intel_ipu7 intel_ipu7_isys intel_ipu7_psys intel_cvs ov08x40 v4l2loopback; do
  check "module loaded: $module" bash -c "grep -q '^${module} ' /proc/modules"
done
check 'IPU7 PSYS character device' bash -c 'test -c /dev/ipu7-psys0 || test -c /dev/ipu-psys0'
check 'IPU7 PSYS access is video-group scoped' bash -c '
  device=/dev/ipu7-psys0
  test -e "$device" || device=/dev/ipu-psys0
  test "$(stat -c %G:%a "$device")" = video:660
'
check 'icamerasrc GStreamer plugin' gst-inspect-1.0 icamerasrc
check 'IPU7 camera service active' systemctl is-active --quiet xps-ipu7-camera.service
check 'v4l2 relay active' systemctl is-active --quiet v4l2-relayd@ipu7.service
check 'Hardware ISP loopback endpoint' bash -c "test -c /dev/video50 && grep -Fxq 'Hardware ISP Camera' /sys/class/video4linux/video50/name"
check 'Hardware ISP endpoint exposes capture formats' v4l2-ctl --device=/dev/video50 --list-formats-ext
check 'PipeWire advertises the Hardware ISP camera' bash -c \
  "pw-dump | jq -e '.. | objects | select(.info?.props?.[\"media.class\"] == \"Video/Source\") | select((.info.props.[\"node.description\"] // .info.props.[\"node.name\"] // \"\") | test(\"Hardware ISP Camera\"; \"i\"))'"
check 'no IPU7 kernel fault in this boot' bash -c \
  "! journalctl -k -b --no-pager 2>/dev/null | grep -Eq 'RIP: .*ipu7|BUG:.*ipu7'"

if [[ ${XPS_CAMERA_FRAME_TEST:-0} == 1 ]]; then
  frame_log=$(mktemp)
  timeout 10s v4l2-ctl --device=/dev/video50 --stream-mmap \
    --stream-count=3 --stream-to=/dev/null --verbose >"$frame_log" 2>&1 || true
  if [[ $(grep -c 'cap dqbuf:' "$frame_log") -ge 3 ]]; then
    pass 'captured three frames from the Hardware ISP camera'
  else
    fail "frame capture smoke test (details: $frame_log)"
  fi
fi

((failures == 0))
