#!/usr/bin/env bash
set -euo pipefail
source /usr/local/libexec/xps-common.sh

repo=abenz1267/elephant
api="https://api.github.com/repos/$repo/releases/latest"
root=/opt/xps-apps/elephant
cache=/var/cache/xps-upstream/elephant
providers=({% for provider in elephant_providers %}{{ provider | quote }} {% endfor %})
mkdir -p "$root" "$cache"

json=$(mktemp)
stage=""
cleanup() { rm -f "$json"; [[ -z $stage ]] || rm -rf "$stage"; }
trap cleanup EXIT
gh_api_fetch "$api" "$cache/api" "$json"
tag=$(jq -er 'select(.draft == false and .prerelease == false) | .tag_name' "$json")
safe_tag=$(printf '%s' "$tag" | tr -c 'A-Za-z0-9._+-' _)
if [[ -L $root/current && $(basename "$(readlink -f "$root/current")") == "$safe_tag" ]]; then
  chmod 0755 "$(readlink -f "$root/current")"
  chown -R root:root "$(readlink -f "$root/current")"
  emit_unchanged "elephant $tag"
  exit 0
fi

stage=$(mktemp -d "$root/.stage.XXXXXX")
mkdir -p "$stage/bin" "$stage/providers" "$cache/$safe_tag"
components=(elephant "${providers[@]}")

declare -A asset_url asset_digest
for component in "${components[@]}"; do
  asset="$component-linux-amd64.tar.gz"
  row=$(jq -er --arg asset "$asset" '.assets[] | select(.name == $asset) | [.browser_download_url,.digest] | @tsv' "$json")
  url=${row%%$'\t'*}
  digest=${row#*$'\t'}
  expected=${digest#sha256:}
  [[ $expected =~ ^[[:xdigit:]]{64}$ ]] || { echo "No digest for $asset" >&2; exit 1; }
  asset_url[$component]=$url
  asset_digest[$component]=$expected
done

# Download all missing assets concurrently, then verify and extract serially.
pids=()
for component in "${components[@]}"; do
  archive="$cache/$safe_tag/$component-linux-amd64.tar.gz"
  [[ -f $archive ]] && continue
  curl --fail --silent --show-error --location --retry 3 \
    --output "$archive.partial" "${asset_url[$component]}" \
    && mv -f "$archive.partial" "$archive" &
  pids+=($!)
done
failed=0
for pid in "${pids[@]}"; do
  wait "$pid" || failed=1
done
(( failed == 0 )) || { echo "One or more elephant asset downloads failed" >&2; exit 1; }

for component in "${components[@]}"; do
  asset="$component-linux-amd64.tar.gz"
  archive="$cache/$safe_tag/$asset"
  verify_sha256 "$archive" "${asset_digest[$component]}" || { echo "Digest mismatch for $asset" >&2; exit 1; }
  if [[ $component == elephant ]]; then
    tar -xzf "$archive" -C "$stage/bin"
    extracted="$stage/bin/$component-linux-amd64"
    [[ -f $extracted ]] || { echo "$asset has unexpected contents" >&2; exit 1; }
    mv "$extracted" "$stage/bin/$component"
    chmod 0755 "$stage/bin/$component"
  else
    tar -xzf "$archive" -C "$stage/providers"
    extracted="$stage/providers/$component-linux-amd64.so"
    [[ -f $extracted ]] || { echo "$asset has unexpected contents" >&2; exit 1; }
    mv "$extracted" "$stage/providers/$component.so"
    chmod 0644 "$stage/providers/$component.so"
  fi
done

chmod 0755 "$stage"
chown -R root:root "$stage"

mkdir -p "$root/versions"
rm -rf "$root/versions/$safe_tag.new"
mv "$stage" "$root/versions/$safe_tag.new"
stage=""
rm -rf "$root/versions/$safe_tag"
mv "$root/versions/$safe_tag.new" "$root/versions/$safe_tag"
atomic_current_swap "$root" "versions/$safe_tag"
ln -sfn "$root/current/bin/elephant" /usr/local/bin/elephant
install -d -m 0755 -o {{ primary_user | quote }} -g {{ primary_group | quote }} \
  {{ (primary_home + '/.config/elephant/providers') | quote }}
for component in "${providers[@]}"; do
  ln -sfn "$root/current/providers/$component.so" \
    {{ (primary_home + '/.config/elephant/providers') | quote }}/"$component.so"
done
xps_restorecon "$root" /usr/local/bin
emit_changed "installed elephant $tag"
