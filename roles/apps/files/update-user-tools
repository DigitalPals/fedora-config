#!/usr/bin/env bash
set -uo pipefail

changed=0
mkdir -p "$HOME/.local/bin" "$HOME/.npm-global"
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$PATH"

if command -v claude >/dev/null 2>&1; then
  before=$(claude --version 2>/dev/null || true)
  claude update >/dev/null 2>&1 || echo "Claude Code update failed; existing version retained" >&2
  after=$(claude --version 2>/dev/null || true)
  [[ $before == "$after" ]] || changed=1
else
  installer=$(mktemp)
  if curl --fail --silent --show-error --location https://claude.ai/install.sh -o "$installer"; then
    # Anthropic's official installer selects and verifies its native artifact.
    bash "$installer" || echo "Claude Code install failed" >&2
    command -v claude >/dev/null 2>&1 && changed=1
  fi
  rm -f "$installer"
fi

before=$(npm --prefix "$HOME/.npm-global" list -g --depth=0 opencode-ai --json 2>/dev/null \
  | jq -r '.dependencies["opencode-ai"].version // empty')
latest=$(npm view opencode-ai version 2>/dev/null || true)
if [[ -z $before || -z $latest || $before != "$latest" ]]; then
  npm --prefix "$HOME/.npm-global" install -g opencode-ai@latest >/dev/null \
    || echo "OpenCode update failed; existing version retained" >&2
  after=$(npm --prefix "$HOME/.npm-global" list -g --depth=0 opencode-ai --json 2>/dev/null \
    | jq -r '.dependencies["opencode-ai"].version // empty')
  [[ $before == "$after" ]] || changed=1
fi

# The existing standalone Codex CLI is authoritative. Never add an npm duplicate.
if command -v codex >/dev/null 2>&1; then
  codex --version >/dev/null 2>&1 || true
else
  echo "Codex CLI is absent; the Fedora config intentionally does not install an npm duplicate." >&2
fi

if (( changed )); then echo "CHANGED: user-managed CLI update"; else echo "UNCHANGED: user-managed CLIs"; fi
