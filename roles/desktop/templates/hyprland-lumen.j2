#!/usr/bin/env bash
set -euo pipefail

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export DESKTOP_SESSION=hyprland-lumen
export DESKTOP_SHELL=lumen
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland

mkdir -p "$XDG_RUNTIME_DIR" "${XDG_STATE_HOME:-$HOME/.local/state}/hyprland"
printf '%s\n' lumen > "$XDG_RUNTIME_DIR/desktop-shell"
session_log="${XDG_STATE_HOME:-$HOME/.local/state}/hyprland/session.log"

systemctl --user import-environment XDG_SESSION_TYPE XDG_CURRENT_DESKTOP \
  XDG_SESSION_DESKTOP DESKTOP_SESSION DESKTOP_SHELL || true
dbus-update-activation-environment --systemd XDG_SESSION_TYPE \
  XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION DESKTOP_SHELL || true

set +e
start-hyprland -- "$@" >>"$session_log" 2>&1
session_status=$?
systemctl --user stop hyprland-session.target >/dev/null 2>&1 || true
exit "$session_status"
