[Unit]
Description=Walker launcher service
After=elephant.service
Requires=elephant.service
PartOf=hyprland-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/walker --gapplication-service
Environment=PATH={{ primary_home }}/.local/bin:{{ primary_home }}/.npm-global/bin:/usr/local/bin:/usr/bin
Restart=on-failure
RestartSec=1

[Install]
WantedBy=hyprland-session.target
