[Unit]
Description=Remote Hermes WebUI Quickshell bridge
PartOf=hyprland-session.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME={{ primary_home }}
Environment=PATH={{ primary_home }}/.local/bin:/usr/local/bin:/usr/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{ primary_home }}/.local/libexec/hermes-menubar-bridge --listen 127.0.0.1 --port 9120 --remote-only --state {{ primary_home }}/.local/state/hermes-menubar/conversations.json --remote-auth-state {{ primary_home }}/.local/state/hermes-menubar/remote-webui-auth.json
Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=hyprland-session.target
