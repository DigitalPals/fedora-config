#!/usr/bin/python3
"""Restore haptic feedback on the Dell XPS Synaptics touchpad.

The touchpad generates feedback itself, but its volatile HID feature settings
must be restored after enumeration or a controller reset.
"""

import fcntl
import glob
import os
import struct
import sys
import time


VENDOR = "06CB"
BUTTON_SWITCH_REPORT = 0x06
HAPTIC_INTENSITY_REPORT = 0x37
# Bit 0 = surface switch, bit 1 = button switch.
BUTTON_SWITCHES = 0x03
INTENSITY = 1

EVENT_FORMAT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
POWER_CONTROL_PATHS = (
    "/sys/bus/pci/devices/0000:00:19.0/power/control",
    "/sys/bus/platform/devices/i2c_designware.0/power/control",
)


def hid_set_feature_ioctl(length):
    return 0xC0000000 | (length << 16) | (ord("H") << 8) | 0x06


def read_uevent(path):
    values = {}
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                key, _, value = line.strip().partition("=")
                if key:
                    values[key] = value
    except OSError:
        pass
    return values


def find_hidraw(phys):
    fallback = None
    for path in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        values = read_uevent(os.path.join(path, "device", "uevent"))
        if f"0000{VENDOR}" not in values.get("HID_ID", "").upper():
            continue

        hidraw = os.path.join("/dev", os.path.basename(path))
        if fallback is None:
            fallback = hidraw
        if phys and values.get("HID_PHYS") == phys:
            return hidraw
    return fallback


def find_touchpad_event():
    for path in sorted(glob.glob("/sys/class/input/event*/device/name")):
        try:
            with open(path, encoding="utf-8") as handle:
                name = handle.read().strip().upper()
            if VENDOR in name and "TOUCHPAD" in name:
                values = read_uevent(os.path.join(os.path.dirname(path), "uevent"))
                event = path.split("/")[-3]
                return os.path.join("/dev/input", event), values.get("PHYS")
        except OSError:
            continue
    return None, None


def find_devices(timeout=15):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        event, phys = find_touchpad_event()
        hidraw = find_hidraw(phys) if event else None
        if event and hidraw:
            return event, hidraw
        time.sleep(0.5)
    return None, None


def keep_controller_awake():
    paths = list(POWER_CONTROL_PATHS)
    paths.extend(glob.glob("/sys/bus/i2c/devices/i2c-VEN_06CB:*/power/control"))
    for path in paths:
        try:
            with open(path, "w", encoding="ascii") as handle:
                handle.write("on\n")
        except OSError as error:
            print(f"Could not keep {path} awake: {error}", file=sys.stderr)


def set_feature(fd, report_id, value):
    report = struct.pack("BB", report_id, value)
    fcntl.ioctl(fd, hid_set_feature_ioctl(len(report)), report)


def main():
    keep_controller_awake()
    event, hidraw = find_devices()
    if not event or not hidraw:
        print("Synaptics haptic touchpad devices did not appear", file=sys.stderr)
        return 1

    hidraw_fd = os.open(hidraw, os.O_RDWR)
    event_fd = os.open(event, os.O_RDONLY)

    try:
        set_feature(hidraw_fd, BUTTON_SWITCH_REPORT, BUTTON_SWITCHES)
        set_feature(hidraw_fd, HAPTIC_INTENSITY_REPORT, INTENSITY)
        print(
            f"Haptic touchpad: hidraw={hidraw} input={event} "
            f"switches={BUTTON_SWITCHES} intensity={INTENSITY}",
            flush=True,
        )

        # Stay tied to this input device. If it resets, read() fails and
        # systemd restarts the service, reapplying both feature reports.
        while True:
            data = os.read(event_fd, EVENT_SIZE)
            if len(data) < EVENT_SIZE:
                continue
    except KeyboardInterrupt:
        pass
    finally:
        os.close(event_fd)
        os.close(hidraw_fd)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
