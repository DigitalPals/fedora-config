#!/usr/bin/env bash
set -euo pipefail
direction=${1:?up or down required}
step=${2:-5}

monitor_make=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .make // ""')
if grep -qi apple <<<"$monitor_make" && command -v asdcontrol >/dev/null 2>&1; then
  for device in /dev/usb/hiddev*; do
    [[ -e $device ]] || continue
    if asdcontrol --silent --detect "$device" 2>/dev/null | grep -q SUPPORTED; then
      if [[ $direction == up ]]; then
        exec asdcontrol --silent --brief "$device" "+$step%"
      else
        exec asdcontrol --silent --brief "$device" -- "-$step%"
      fi
    fi
  done
  command -v notify-send >/dev/null && notify-send "Display brightness" "Supported Apple display control was not found"
  exit 0
fi

if [[ $direction == up ]]; then
  exec brightnessctl set "$step%+"
else
  exec brightnessctl set "$step%-"
fi
