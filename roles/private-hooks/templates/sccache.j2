#!/usr/bin/env bash
set -euo pipefail
export SCCACHE_CACHE_SIZE=100G
token_file={{ private_services.sccache_token_file | quote }}
scheduler_url={{ private_services.sccache_scheduler_url | quote }}
allow_insecure={{ allow_insecure_sccache_transport | bool | ternary('true', 'false') | quote }}
host=""
port=""

case "$scheduler_url" in
  https://*) ;;
  http://*)
    if [[ $allow_insecure != true ]]; then
      printf 'sccache: refusing plaintext distributed scheduler; using local cache\n' >&2
      scheduler_url=""
    fi
    ;;
  "") ;;
  *)
    printf 'sccache: scheduler URL must use https:// (or explicitly allowed http://); using local cache\n' >&2
    scheduler_url=""
    ;;
esac

if [[ $scheduler_url =~ ^https?://([A-Za-z0-9.-]+)(:([0-9]{1,5}))?/?$ ]]; then
  host=${BASH_REMATCH[1]}
  port=${BASH_REMATCH[3]}
  if [[ -z $port ]]; then
    [[ $scheduler_url == https://* ]] && port=443 || port=80
  fi
  if ((port < 1 || port > 65535)); then
    host=""
  fi
elif [[ -n $scheduler_url ]]; then
  printf 'sccache: invalid scheduler URL; using local cache\n' >&2
  scheduler_url=""
fi

if [[ -n $host && -r $token_file ]] \
    && timeout 1 bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "$host" "$port" 2>/dev/null; then
  export SCCACHE_DIST_SCHEDULER_URL="$scheduler_url"
  export SCCACHE_DIST_AUTH_TOKEN="$(<"$token_file")"
fi
exec /usr/bin/sccache "$@"
