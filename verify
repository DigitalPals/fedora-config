#!/usr/bin/env bash
# Explicit, non-destructive verification scopes. The default remains the full
# source gate followed by installed-system checks.
set -uo pipefail
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || exit 1
cd -- "$repo_root" || exit 1

usage() {
  cat <<'EOF'
Usage: ./verify [--source | --system | --quick] [--json] [--require-hyprland]

Scopes (choose at most one):
  --source             Run the complete source-tree gate only.
  --system             Inspect the installed system only.
  --quick              Run the short source preflight only.
  (no scope)           Run the complete source and system checks.

Output and policy:
  --json               Emit one machine-readable JSON document.
  --require-hyprland   Fail instead of skipping live Hyprland checks.
  -h, --help           Show this help.
EOF
}

scope=all
scope_seen=false
json=false
require_hyprland=false
while (($#)); do
  case $1 in
    --source|--system|--quick)
      if $scope_seen; then
        printf 'verify: choose only one of --source, --system, or --quick\n' >&2
        exit 2
      fi
      scope=${1#--}
      scope_seen=true
      ;;
    --json) json=true ;;
    --require-hyprland) require_hyprland=true ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'verify: unknown argument %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if [[ $scope == source || $scope == quick ]] && $require_hyprland; then
  printf 'verify: --require-hyprland applies only to system checks\n' >&2
  exit 2
fi

run_source=false
run_system=false
quick=false
case $scope in
  all) run_source=true; run_system=true ;;
  source) run_source=true ;;
  system) run_system=true ;;
  quick) run_source=true; quick=true ;;
esac

source_rc=0
system_rc=0
source_output=''
system_output=''
source_command=(./tests/run)
$quick && source_command+=(--quick)
system_command=(./tests/verify-system)
$require_hyprland && system_command+=(--require-hyprland)

if $json; then
  if $run_source; then
    source_output=$("${source_command[@]}" 2>&1) || source_rc=$?
  fi
  if $run_system; then
    system_output=$("${system_command[@]}" 2>&1) || system_rc=$?
  fi
  command -v python3 >/dev/null 2>&1 || {
    printf 'verify: --json requires python3\n' >&2
    exit 2
  }
  VERIFY_SCOPE=$scope \
  VERIFY_SOURCE_RAN=$run_source VERIFY_SOURCE_RC=$source_rc \
  VERIFY_SYSTEM_RAN=$run_system VERIFY_SYSTEM_RC=$system_rc \
  VERIFY_SOURCE_OUTPUT=$source_output VERIFY_SYSTEM_OUTPUT=$system_output \
    python3 - <<'PY'
import json
import os

def result(prefix):
    ran = os.environ[f"VERIFY_{prefix}_RAN"] == "true"
    code = int(os.environ[f"VERIFY_{prefix}_RC"])
    return {
        "ran": ran,
        "ok": code == 0 if ran else None,
        "exitCode": code if ran else None,
        "output": os.environ[f"VERIFY_{prefix}_OUTPUT"] if ran else "",
    }

source = result("SOURCE")
system = result("SYSTEM")
print(json.dumps({
    "ok": (not source["ran"] or source["ok"]) and
          (not system["ran"] or system["ok"]),
    "scope": os.environ["VERIFY_SCOPE"],
    "source": source,
    "system": system,
}, separators=(",", ":")))
PY
  json_rc=$?
else
  if $run_source; then
    "${source_command[@]}" || source_rc=$?
  fi
  if $run_source && $run_system; then
    printf '\n'
  fi
  if $run_system; then
    "${system_command[@]}" || system_rc=$?
  fi
fi

((source_rc == 0 && system_rc == 0 && ${json_rc:-0} == 0))
