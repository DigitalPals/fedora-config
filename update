#!/usr/bin/env bash
# XPS update wrapper, v2 "mission control" UI (design 2a).
# Same semantics as v1: dnf + flatpak run concurrently, a flatpak failure
# warns and continues, a dnf failure aborts; then the playbook converges
# with --skip-tags boot,finalize. Full logs land under xps-update/logs/.
set -uo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
# shellcheck source=scripts/ui.sh
source scripts/ui.sh

log_root="${XDG_STATE_HOME:-$HOME/.local/state}/xps-update/logs/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$log_root"
start=$SECONDS

fedora_version=$(. /etc/os-release && echo "$VERSION_ID")

# Cache sudo credentials once so the parallel steps below never prompt.
sudo -n true 2>/dev/null || sudo -v

# ── header ──────────────────────────────────────────────────────────────────
printf '\n  '; ui_grad_text 'XPS UPDATE'
printf '%s   Fedora %s%s\n' "$UI_GREY" "$fedora_version" "$UI_RESET"
printf '  '; ui_rule
printf '  %skernel %s · logs → %s%s\n\n' "$UI_GREY" "$(uname -r)" "$log_root" "$UI_RESET"
printf '  %sSYSTEM%s\n' "$UI_BOLD" "$UI_RESET"

# ── log parsers ──────────────────────────────────────────────────────────────
dnf_detail() {
  local log=$1 n
  grep -q '^Nothing to do' "$log" && { echo "already up to date"; return; }
  n=$(awk '/^ *(Installing|Upgrading|Reinstalling|Downgrading|Removing|Replacing):/ { sum += $2 } END { print sum + 0 }' "$log")
  if (( n > 0 )); then echo "$n packages"; else echo "completed"; fi
}

flatpak_detail() {
  local log=$1 n
  grep -qi '^Nothing to' "$log" && { echo "already up to date"; return; }
  n=$(grep -cE '^ *[0-9]+\.[[:space:]]' "$log" || true)
  if (( n > 0 )); then echo "$n apps"; else echo "completed"; fi
}

# First three package names + "+N more" for the dim summary line.
dnf_top() {
  awk '/^\[ *[0-9]+\/[0-9]+\] (Upgrading|Installing) /{
      sub(/^\[[^]]*\] (Upgrading|Installing) +/, ""); sub(/ .*/, "")
      names[n++] = $0
    } END {
      if (!n) exit
      s = names[0]; for (i = 1; i < 3 && i < n; i++) s = s " · " names[i]
      if (n > 3) s = s "  +" (n - 3) " more"
      print s
    }' "$1"
}

# ── launch the parallel system phase ────────────────────────────────────────
sudo dnf -y upgrade --refresh >"$log_root/dnf.log" 2>&1 &
dnf_pid=$!
sudo flatpak update --system --noninteractive >"$log_root/flatpak.log" 2>&1 &
flatpak_pid=$!

dnf_rc='' flatpak_rc=''
trap 'printf "\033[?25h"' EXIT
trap 'kill "$dnf_pid" "$flatpak_pid" 2>/dev/null; printf "\033[?25h\n"; exit 130' INT

if [[ -t 1 ]]; then
  # ── live dashboard: two step rows + scrolling tagged package feed ─────────
  FEED_MAX=8
  REGION=$(( 3 + FEED_MAX ))   # dnf row, flatpak row, blank, feed
  feed_tag=() feed_txt=()
  dnf_seen=0 fp_seen=0 tick=0
  printf '\033[?25l'
  for (( i = 0; i < REGION; i++ )); do printf '\n'; done

  harvest_feeds() {
    local line
    # dnf5 transaction lines look like "[ 12/226] Upgrading kernel-core-…".
    while IFS= read -r line; do
      feed_tag+=('dnf'); feed_txt+=("$line"); (( ++dnf_seen ))
    done < <(grep -E '^\[ *[0-9]+/[0-9]+\]' "$log_root/dnf.log" 2>/dev/null \
             | sed -E 's/^\[[^]]*\] +//' | tail -n +"$((dnf_seen + 1))")
    while IFS= read -r line; do
      feed_tag+=('fpk'); feed_txt+=("$line"); (( ++fp_seen ))
    done < <(grep -E '^(Updating|Installing|Uninstalling) ' "$log_root/flatpak.log" 2>/dev/null \
             | tail -n +"$((fp_seen + 1))")
  }

  # paint_step <rc-or-empty> <color> <label> <cur> <total> <unit> <frame> <okmsg> <failmsg>
  paint_step() {
    local rc=$1 color=$2 label=$3 cur=$4 total=$5 unit=$6 frame=$7 okmsg=$8 failmsg=$9 pct
    printf '\033[2K'
    if [[ -n $rc && $rc -eq 0 ]]; then
      printf '  %s✓%s %-18s %s%s%s\n' "$UI_GREEN" "$UI_RESET" "$label" "$UI_GREY" "$okmsg" "$UI_RESET"
    elif [[ -n $rc ]]; then
      printf '  %s✗%s %-18s %s%s%s\n' "$UI_RED" "$UI_RESET" "$label" "$UI_RED" "$failmsg" "$UI_RESET"
    elif (( total > 0 )); then
      pct=$(( cur * 100 / total ))
      printf '  %s%s%s %-18s ' "$color" "$frame" "$UI_RESET" "$label"
      ui_bar "$pct" 22 "$color"
      printf ' %s%3d%%%s  %s%d/%d %s  %s%s\n' \
        "$UI_BOLD" "$pct" "$UI_RESET" "$UI_GREY" "$cur" "$total" "$unit" "$(ui_mmss $((SECONDS - start)))" "$UI_RESET"
    else
      printf '  %s%s%s %-18s %sdownloading & resolving…  %s%s\n' \
        "$color" "$frame" "$UI_RESET" "$label" "$UI_GREY" "$(ui_mmss $((SECONDS - start)))" "$UI_RESET"
    fi
  }

  paint() {
    local frame=${UI_SPIN:tick % 10:1} cur total n from idx s col tc
    printf '\033[%dA' "$REGION"
    read -r cur total <<<"$(grep -Eo '\[ *[0-9]+/[0-9]+\]' "$log_root/dnf.log" 2>/dev/null \
                            | tail -1 | tr -dc '0-9/' | awk -F/ '{print $1, $2}')"
    paint_step "$dnf_rc" "$UI_CYAN" 'System packages' "${cur:-0}" "${total:-0}" 'pkgs' "$frame" \
      'completed' 'dnf upgrade failed'
    total=$(grep -cE '^ *[0-9]+\.[[:space:]]' "$log_root/flatpak.log" 2>/dev/null || true)
    paint_step "$flatpak_rc" "$UI_PINK" 'Flatpaks' "$fp_seen" "${total:-0}" 'apps' "$frame" \
      'completed' 'update failed — will continue'
    printf '\033[2K\n'
    n=${#feed_txt[@]}; from=$(( n > FEED_MAX ? n - FEED_MAX : 0 ))
    for (( s = 0; s < FEED_MAX; s++ )); do
      printf '\033[2K'
      idx=$(( from + s ))
      if (( idx < n )); then
        col=$UI_GREY; (( idx == n - 1 )) && col=$UI_FG
        tc=$UI_CYAN; [[ ${feed_tag[idx]} == fpk ]] && tc=$UI_PINK
        printf '      %s%-5s%s%s↑%s %s%s%s\n' \
          "$tc" "${feed_tag[idx]}" "$UI_RESET" "$UI_GREEN" "$UI_RESET" "$col" "${feed_txt[idx]:0:60}" "$UI_RESET"
      else
        printf '\n'
      fi
    done
  }

  while :; do
    if [[ -z $dnf_rc ]] && ! kill -0 "$dnf_pid" 2>/dev/null; then
      wait "$dnf_pid"; dnf_rc=$?
    fi
    if [[ -z $flatpak_rc ]] && ! kill -0 "$flatpak_pid" 2>/dev/null; then
      wait "$flatpak_pid"; flatpak_rc=$?
    fi
    harvest_feeds
    paint
    [[ -n $dnf_rc && -n $flatpak_rc ]] && break
    sleep 0.1
    (( ++tick ))
  done
  # Collapse the dashboard region; the summary lines below replace it.
  printf '\033[%dA\033[J' "$REGION"
  printf '\033[?25h'
else
  ui_spin_while 'System packages + Flatpaks' "$dnf_pid" "$flatpak_pid"
  wait "$dnf_pid"; dnf_rc=$?
  wait "$flatpak_pid"; flatpak_rc=$?
fi

sys_dur=$(ui_duration $((SECONDS - start)))

if (( dnf_rc == 0 )); then
  ui_ok 'System packages' "$(dnf_detail "$log_root/dnf.log") ($sys_dur)"
  top=$(dnf_top "$log_root/dnf.log")
  [[ -n $top ]] && printf '        %s%s%s\n' "$UI_GREY" "$top" "$UI_RESET"
else
  ui_fail 'System packages' 'dnf upgrade failed'
  ui_tail_log "$log_root/dnf.log"
  printf '\n%sFull log: %s/dnf.log%s\n' "$UI_GREY" "$log_root" "$UI_RESET"
  ui_box "$UI_RED" '✗' "Update failed after $(ui_duration $((SECONDS - start)))" \
    'dnf upgrade failed — configuration run skipped'
  exit "$dnf_rc"
fi

if (( flatpak_rc == 0 )); then
  ui_ok 'Flatpaks' "$(flatpak_detail "$log_root/flatpak.log")"
else
  # A transient Flathub failure should not block the configuration run.
  ui_warn 'Flatpaks' "update failed — continuing (log: $log_root/flatpak.log)"
fi

printf '\n  %sCONFIGURATION%s\n' "$UI_BOLD" "$UI_RESET"
ansible_rc=0
ansible-playbook site.yml --skip-tags boot,finalize "$@" || ansible_rc=$?

total=$(ui_duration $((SECONDS - start)))
if (( ansible_rc == 0 && flatpak_rc == 0 )); then
  ui_box "$UI_GREEN" '✓' "Update complete in $total" \
    "$(dnf_detail "$log_root/dnf.log") · $(flatpak_detail "$log_root/flatpak.log") · configuration converged"
elif (( ansible_rc == 0 )); then
  ui_box "$UI_YELLOW" '!' "Update finished in $total with warnings" "logs: $log_root"
else
  ui_box "$UI_RED" '✗' "Update failed after $total" "logs: $log_root"
fi
exit "$ansible_rc"
